{
  "name": "pte-tracker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "dev": "concurrently -n api,web \"node --watch server/index.js\" \"npm run dev --prefix client\"",
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "seed": "node server/seed.js"
  },
  "dependencies": { "cors": "^2.8.5", "dotenv": "^16.4.5", "express": "^4.19.2", "mongoose": "^8.6.0" },
  "devDependencies": { "concurrently": "^9.0.0" }
}
